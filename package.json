{
  "name": "@open-vibe-ai/stt-sdk",
  "version": "0.2.0",
  "description": "Voice Typer provider-communication library: one normalized interface for local runtime endpoints and cloud STT APIs.",
  "keywords": [
    "speech-to-text",
    "stt",
    "whisper",
    "faster-whisper",
    "deepgram",
    "transcription"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mariuszRep/stt-sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "ws": "^8.18.0"
  }
}
